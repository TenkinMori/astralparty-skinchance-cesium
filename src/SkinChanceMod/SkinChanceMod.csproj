<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SkinChanceMod</AssemblyName>
    <RootNamespace>SkinChanceMod</RootNamespace>
    <!-- 离线构建时不访问 nuget.org 拉漏洞库 -->
    <NuGetAudit>false</NuGetAudit>
    <!-- 不把 git 提交号写进 AssemblyInformationalVersion，保证可复现构建 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CesiumLoader.SDK">
      <HintPath>..\..\lib\CesiumLoader.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstralParty.Runtime">
      <HintPath>..\..\refs\game\AstralParty.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\refs\game\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 引擎自带的图片解码器（ImageConversion.LoadImage）：覆盖 JPG/WEBP/GIF 等托管解不了的格式 -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\..\refs\game\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="SkinChanceMod.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
